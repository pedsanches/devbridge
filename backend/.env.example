# ============================================================
# DevBridge Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values
# cp .env.example .env
# ============================================================

# ============ Application ============
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ============ Database ============
DATABASE_URL=postgresql://devbridge:devbridge@localhost:5432/devbridge

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============ Vector Database ============
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=devbridge

# ============ AI / LLM ============
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# ============ GitHub ============
GITHUB_WEBHOOK_SECRET=

# ============ Presidio ============
PRESIDIO_ANALYZER_URL=http://localhost:5001
PRESIDIO_ANONYMIZER_URL=http://localhost:5002
