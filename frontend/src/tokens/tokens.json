{
    "$schema": "https://design-tokens.org/schema/1.0",
    "$description": "DevBridge Design Tokens - W3C DTCG Format",
    "color": {
        "primary": {
            "$value": "#0071E3",
            "$type": "color",
            "$description": "Primary brand color - used for CTAs and key interactive elements"
        },
        "primary-hover": {
            "$value": "#0077ED",
            "$type": "color",
            "$description": "Primary hover state"
        },
        "secondary": {
            "$value": "#86868B",
