# ============================================================
# DevBridge Environment Variables
# ============================================================
# Copy this file to .env and fill in the values
# cp .env.example .env
# ============================================================

# ============ Application ============
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ============ API ============
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# ============ Database ============
DATABASE_URL=postgresql://devbridge:devbridge@localhost:5432/devbridge
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============ Vector Database (Qdrant) ============
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=devbridge

# ============ AI / LLM ============
ANTHROPIC_API_KEY=sk-ant-api03-xxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Optional: for embeddings if using OpenAI
# OPENAI_API_KEY=sk-xxx
# EMBEDDING_MODEL=text-embedding-3-small

# ============ GitHub ============
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret
# GitHub Personal Access Token (alternative to App)
# GITHUB_TOKEN=ghp_xxx

# ============ Slack ============
SLACK_BOT_TOKEN=xoxb-xxx
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_DEFAULT=#devbridge-alerts

# ============ Security ============
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# ============ Privacy (Presidio) ============
PRESIDIO_ANALYZER_URL=http://localhost:5001
PRESIDIO_ANONYMIZER_URL=http://localhost:5002
# Languages for PII detection
PRESIDIO_LANGUAGES=["pt", "en"]

# ============ Feature Flags ============
ENABLE_SLACK_NOTIFICATIONS=true
ENABLE_DAILY_SUMMARY=true
ENABLE_RAG_CHAT=true
